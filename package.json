{
  "name": "phrontis-mobile",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "smoke": "vite build && node scripts/smoke.mjs",
    "verify:md": "node --experimental-strip-types --no-warnings scripts/verify-markdown.mjs",
    "cap:sync": "vite build && node scripts/sync-android.mjs",
    "android:open": "cap open android",
    "android:apk": "vite build && node scripts/sync-android.mjs && cd android && set \"JAVA_HOME=D:\\develp\\jdk-21.0.2\"&& set \"GRADLE_USER_HOME=D:\\develp\\.gradle\"&& gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "dompurify": "^3.4.17",
    "jsqr": "^1.4.0",
    "marked": "^18.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.10"
  }
}
