<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- usesCleartextTraffic：允许 http:// 端点。AI 直连与「电脑伴侣」都可能是局域网 http
         （Ollama / 自建网关 / 电脑同步端口），Android 9+ 默认全部拒绝，表现为「电脑能连、手机连不上」。
         代价是接受明文传输；本应用除用户自填的 API 地址外不向公网发送数据。 -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <!-- windowSoftInputMode=adjustNothing：键盘高度由 MainActivity 读原生 IME inset，
             注入 CSS 变量 kb-native 来驱动布局（注意 XML 注释里不能出现连续两个减号，故不写前导横线）。
             不让系统再动窗口 —— adjustResize 在 Android 15 edge-to-edge 下已失效（不缩窗），
             而老 Android 上它真会缩 WebView，与本机制叠加就成了双重扣；adjustPan 更糟（整页平移）。 -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 扫码配对：Capacitor 的 BridgeWebChromeClient 会把 WebView 的 VIDEO_CAPTURE 请求
         转成 CAMERA 运行时权限弹窗（须先在此声明，否则 hasDefinedPermission 为假） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 日程提醒的本地通知（@capacitor/local-notifications）：Android 13+ 通知是运行时权限，
         由 lib/notify.ts 启动时 requestPermissions 弹窗申请；13 以下安装即有。
         拒绝后不再反复骚扰，设置页「工具」卡有状态行引导去系统设置重开。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 触感反馈：navigator.vibrate 在 WebView 里要求 app 持有该权限，未声明会静默失败
         （勾选待办 / 长按删除的 10ms 顿感此前在真机上实际不生效） -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
